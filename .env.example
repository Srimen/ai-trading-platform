# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Seconds before a quote is treated as stale
STALE_AFTER_SECONDS=60

# Market data provider (added in a later commit)
MARKET_DATA_API_KEY=

# Paper broker sandbox (added in a later commit)
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=